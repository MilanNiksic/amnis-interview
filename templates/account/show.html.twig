{% extends 'base.html.twig' %}

{% block title %}Account details{% endblock %}

{% block body %}
    <h1>Account details</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ account.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ account.name }}</td>
            </tr>
            <tr>
                <th>Business Partner</th>
                <td>{{ account.businessPartner.name }}</td>
            </tr>
            <tr>
                <th>Currency</th>
                <td>{{ account.currency.code }}</td>
            </tr>
            <tr>
                <th>Balance</th>
                <td>{{ account.balance }}</td>
            </tr>
            <tr>
                <th>Account number</th>
                <td>{{ account.accountNumber }}</td>
            </tr>
            <tr>
                <th>Active</th>
                <td>{{ account.active ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <a class="btn btn-sm btn-outline-secondary float-start" href="{{ path('app_account_list', {'businessPartnerId': account.businessPartner.id}) }}">Back to list</a>
    <a class="btn btn-sm btn-outline-primary float-end" href="{{ path('app_account_edit', {'id': account.id}) }}">Edit</a>

    {{ include('account/_delete_form.html.twig') }}
{% endblock %}
