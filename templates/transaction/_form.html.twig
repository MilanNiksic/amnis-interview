{{ form_start(form) }}
    {{ form_widget(form) }}
    <button class="btn btn-sm btn-outline-primary float-end">{{ button_label|default('Save') }}</button>
{{ form_end(form) }}

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const businessPartnerSelect = document.getElementById('transaction_businessPartner');
        const accountSelect = document.getElementById('transaction_account');

        if (businessPartnerSelect && accountSelect) {
            businessPartnerSelect.addEventListener('change', function() {
                const partnerId = this.value;
                if (!partnerId) {
                    // Clear accounts if no partner selected
                    accountSelect.innerHTML = '<option value="">Select an account</option>';
                    accountSelect.disabled = true;
                    return;
                }

                // Fetch accounts for this partner
                fetch(`/api/business_partners/${partnerId}/accounts`)
                    .then(response => response.json())
                    .then(data => {
                        // Clear existing options
                        accountSelect.innerHTML = '<option value="">Select an account</option>';
                        let accounts = data['hydra:member'] ?? [];

                        // Add new options
                        accounts.forEach(account => {
                            const option = document.createElement('option');
                            option.value = account.id;
                            option.textContent = `${account.name} (${account.currencyCode})`;
                            accountSelect.appendChild(option);
                        });

                        // Enable account field
                        accountSelect.disabled = false;
                    })
                    .catch(error => {
                        console.error('Error fetching accounts:', error);
                        accountSelect.disabled = true;
                    });
            });
        }
    });
</script>
